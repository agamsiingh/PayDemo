# ---- Frontend (safe to expose; these are PUBLIC values) ----
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# ---- Edge Function secrets (NEVER put these in the frontend) ----
# Set with:  supabase secrets set SILKPAY_API_TOKEN=... SITE_URL=... ADMIN_KEY=...
# Leave SILKPAY_API_TOKEN unset to run in DEMO MODE (fake cashier, no real API calls).
SILKPAY_API_TOKEN=
SITE_URL=http://localhost:5173
ADMIN_KEY=choose-a-long-random-string
